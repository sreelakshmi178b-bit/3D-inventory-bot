# Copy this file to .env for local testing, or paste each value into your
# host's "Environment Variables" settings when deploying.

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# The long ID in your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
SPREADSHEET_ID=

# Paste the ENTIRE contents of your Google service account JSON key file
# here, all on one line. Keep the quotes.
GOOGLE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "...", ...}'

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Get your own ID by messaging @userinfobot on Telegram.
# Leave blank while testing, but set it before sharing the bot token with anyone
# else, since this is your private business inventory.
TELEGRAM_ALLOWED_USER_IDS=

# Optional: kg threshold for /lowstock (default 0.2 = 200g)
LOW_STOCK_THRESHOLD_KG=0.2
